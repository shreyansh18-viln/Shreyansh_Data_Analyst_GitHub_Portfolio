Transaction Count = DISTINCTCOUNT(transactions[transaction_id])\nSuccessful Transactions = CALCULATE([Transaction Count],transactions[status]="Successful")\nSuccessful Value = CALCULATE(SUM(transactions[amount]),transactions[status]="Successful")\nAverage Transaction Value = DIVIDE([Successful Value],[Successful Transactions],0)\nFailed Transactions = CALCULATE([Transaction Count],transactions[status]="Failed")
